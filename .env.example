# Infra (portas no host — docker-compose)
POSTGRES_PORT=6015
REDIS_PORT=6016

# Conexões
DATABASE_URL=postgresql://postgres:postgres@localhost:6015/projeto_politica_ia
REDIS_URL=redis://localhost:6016

# Auth
JWT_ACCESS_SECRET=change-me-to-a-secret-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Backend
PORT=3011

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3011
